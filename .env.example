# Copy to .env, which is gitignored and never committed. hexai/__init__.py and every script in
# scripts/ load it, so a notebook kernel and pytest see these the same way a `uv run` does.
# An already-exported variable wins over anything set here.

WANDB_API_KEY=
WANDB_PROJECT=vvae
WANDB_ENTITY=

# Only when the dataset is not at ./data/tartanground, which is a symlink to ../mjlab/data
TARTAN_ROOT=

# The separate tartanairpy checkout's interpreter, for scripts/download_tartanground.py
TARTANAIR_PYTHON=
